# Copy to .env in this folder. Server loads Portfolio/.env via server/loadEnv.js

PORT=5050

# MongoDB Atlas (use standard URI if mongodb+srv DNS fails on your network)
DATABASE=

# --- Outbound mail (pick one) ---
# Recommended on Render/Vercel-style hosts: Resend (HTTPS). Gmail SMTP often times out from cloud IPs.
# https://resend.com — create API key, optional domain; sandbox: from onboarding@resend.dev
RESEND_API_KEY=
# Sender must be allowed in Resend (verified domain or onboarding@resend.dev for testing)
RESEND_FROM=Portfolio <onboarding@resend.dev>
# Where to receive "new contact form" alerts (defaults to EMAIL / MAIL_USER if unset)
# NOTIFY_EMAIL=

# Gmail SMTP — App Password (often blocked or slow from cloud hosts; use Resend above for production)
EMAIL=
EMAIL_PASS=

# Optional: Atlas SRV DNS (comma-separated), e.g. 8.8.8.8,1.1.1.1
# MONGODB_DNS_SERVERS=

# Production CORS — comma-separated front-end origins (Render).
# Must include every deployed frontend origin (e.g. Vercel) or the browser blocks /register.
# Example: CLIENT_ORIGINS=https://say-hi-satyam.vercel.app,http://localhost:3000
# CLIENT_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- Optional: client/.env.local (Create React App) ---
# REACT_APP_PROXY_TARGET=http://127.0.0.1:5050
# REACT_APP_API_URL=
# REACT_APP_NO_PROXY=
# REACT_APP_FORCE_PROD_API=
