# Copy to .env in this folder. Server loads Portfolio/.env via server/loadEnv.js

PORT=5050

# MongoDB Atlas (use standard URI if mongodb+srv DNS fails on your network)
DATABASE=

# Gmail SMTP — use an App Password (Google Account → Security → 2FA → App passwords)
EMAIL=
EMAIL_PASS=

# Optional: Atlas SRV DNS (comma-separated), e.g. 8.8.8.8,1.1.1.1
# MONGODB_DNS_SERVERS=

# Production CORS — comma-separated front-end origins (Render).
# Must include every deployed frontend origin (e.g. Vercel) or the browser blocks /register.
# Example: CLIENT_ORIGINS=https://say-hi-satyam.vercel.app,http://localhost:3000
# CLIENT_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# --- Optional: client/.env.local (Create React App) ---
# REACT_APP_PROXY_TARGET=http://127.0.0.1:5050
# REACT_APP_API_URL=
# REACT_APP_NO_PROXY=
# REACT_APP_FORCE_PROD_API=
